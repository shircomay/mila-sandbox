index 0000000..7b367f9
--- /dev/null
+++ b/Packages/EchoCancellation/Sources/CSpeexDSP/mdf.c
@@ -0,0 +1,1279 @@
+/* Copyright (C) 2003-2008 Jean-Marc Valin
