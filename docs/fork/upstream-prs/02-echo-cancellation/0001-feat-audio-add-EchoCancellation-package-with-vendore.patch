+++ b/Packages/EchoCancellation/Tools/linux-harness/aec3_compare.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Optional: run the same scenarios through WebRTC AEC3 (pip package
+pywebrtc-audio, a pybind11 wrapper of the WebRTC audio processing module) next
+to the Speex backend, to tell whether swapping the backend later could pay off.
+
+    python3 -m venv /tmp/aec3-venv && /tmp/aec3-venv/bin/pip install numpy pywebrtc-audio
+    cd Packages/EchoCancellation/Tools/linux-harness && sh build.sh build
+    /tmp/aec3-venv/bin/python aec3_compare.py --lib build/libaecharness.so
+
+Not needed to build or test the package. Do not commit the venv.
+AEC3 gets exactly what the Speex backend gets (frames of 10 ms, the far stream
+already time-aligned and advanced by the stage's 30 ms lead); it estimates its
+own delay internally.
+"""
+from __future__ import annotations
+
+import argparse
+import math
+import os
+
+import numpy as np
+
+import synth
+import tune
+from backend import BackendConfig
+
+SR = tune.SR
+
+
+def run_aec3(mic: np.ndarray, far_al: np.ndarray, stream_delay_ms: int = 0) -> np.ndarray:
+    import pywebrtc_audio as webrtc
+
+    ec = webrtc.EchoCanceller(sample_rate=SR, num_channels=1, stream_delay_ms=stream_delay_ms)
+    n = 160
+    frames = min(len(mic), len(far_al)) // n
+    out = np.zeros(frames * n, dtype=np.float32)
+    mic = np.ascontiguousarray(mic, dtype=np.float32)
+    far_al = np.ascontiguousarray(far_al, dtype=np.float32)
+    for i in range(frames):
+        s = slice(i * n, (i + 1) * n)
+        out[s] = ec.process(mic[s], far_al[s])
+    return out
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lib", default=os.path.join("build", "libaecharness.so"))
+    args = ap.parse_args()
+    os.environ["AEC_HARNESS_LIB"] = args.lib
+    cfg = BackendConfig()
+    seconds = 40
+    far_al = tune.aligned_far(seconds)
+    near = tune.near_signal(seconds)
+    noise = tune.noise_signal(seconds)
+    rows = []
+
+    def compare(name, mic, echo=None, nonlinear=False):
+        speex, _ = tune.run_backend(cfg, mic, far_al)
+        aec3 = run_aec3(mic, far_al)
+        r = []
+        for (a, b) in ((3, 6), (6, 12), (12, 25), (25, 40)):
+            r.append(f"{tune.erle(mic, speex, far_al, a, b):.1f} / {tune.erle(mic, aec3, far_al, a, b):.1f}")
+        rows.append([name] + r)
+
+    echo = tune.echo_signal(seconds)
+    compare("far-only (linear room)", echo + noise)
+    compare("far-only, tanh speaker", tune.echo_signal(seconds, nonlinear=True) + noise)
+    compare("far-only, echo delay 120 ms", tune.echo_signal(seconds, delay_ms=120.0) + noise)
+    print("\n### Speex vs WebRTC AEC3: ERLE (dB), Speex / AEC3\n")
+    print(tune.table(["scenario", "3-6 s", "6-12 s", "12-25 s", "25-40 s"], rows))
+
+    # double talk and near-only transparency
+    mic = near + echo + noise
+    speex, _ = tune.run_backend(cfg, mic, far_al)
+    aec3 = run_aec3(mic, far_al)
+    ideal_in = near + noise
+    s, e = 12 * SR, seconds * SR
+    dt = (tune.active_mask(near) & tune.active_mask(echo))[s:e]
+    rows = []
+    for name, out in (("Speex", speex), ("AEC3", aec3)):
+        # compare with the near-only microphone passed through the SAME canceller
+        if name == "Speex":
+            ideal, _ = tune.run_backend(cfg, ideal_in, np.zeros_like(near))
+        else:
+            ideal = run_aec3(ideal_in, np.zeros_like(near))
+        o = out[s:e][dt].astype(np.float64)
+        i = ideal[s:e][dt].astype(np.float64)
+        ec = echo[s:e][dt].astype(np.float64)
+        g = float(np.dot(o, i) / np.dot(i, i))
+        rows.append([name, f"{20 * math.log10(abs(g)):.2f}", f"{float(np.dot(o, i) / math.sqrt(np.dot(o, o) * np.dot(i, i))):.3f}",
+                     f"{tune.db(tune.energy(o - i) / tune.energy(ec)):.1f}"])
+    print("\n### Double talk (12-40 s): near-end retention vs the same canceller on the near-only microphone\n")
+    print(tune.table(["canceller", "retention gain (dB)", "correlation", "(out-ideal) vs echo (dB)"], rows))
+
+    rows = []
+    for name, fn in (("Speex", lambda m: tune.run_backend(cfg, m, np.zeros_like(near))[0]),
+                     ("AEC3", lambda m: run_aec3(m, np.zeros_like(near)))):
+        out = fn(ideal_in)
+        a = ideal_in[2 * SR:len(out) - 1000].astype(np.float64)
+        best = (0.0, 0)
+        for lag in range(-400, 401):          # AEC3 delays its output by a few ms
+            b = out[2 * SR + lag:len(out) - 1000 + lag].astype(np.float64)
+            c = float(np.dot(a, b) / math.sqrt(np.dot(a, a) * np.dot(b, b)))
+            if abs(c) > abs(best[0]):
+                best = (c, lag)
+        b0 = out[2 * SR:len(out) - 1000].astype(np.float64)
+        rows.append([name, f"{tune.db(tune.energy(b0) / tune.energy(a)):.2f}", f"{best[1] / 16:.1f} ms", f"{best[0]:.3f}"])
+    print("\n### Near-end only (far silent)\n")
+    print(tune.table(["canceller", "energy vs input (dB)", "output lag", "correlation at that lag"], rows))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Packages/EchoCancellation/Tools/linux-harness/aec_harness.c b/Packages/EchoCancellation/Tools/linux-harness/aec_harness.c
new file mode 100644
index 0000000..ce87de2
--- /dev/null
+++ b/Packages/EchoCancellation/Tools/linux-harness/aec_harness.c
@@ -0,0 +1,227 @@
+/* aec_harness.c -- C mirror of Sources/EchoCancellation/SpeexEchoCanceller.swift
+ * used to tune the defaults (see TUNING.md).
+ *
+ * It does exactly what the Swift backend does per frame: Float -> Int16
+ * (x32767, clamped, rounded), speex_echo_cancellation(), optional
+ * speex_preprocess_run() on the echo-cancelled frame for residual echo
+ * suppression, Int16 -> Float (/32768). Keep the two in sync.
+ *
+ * Two build products (see build.sh):
+ *   aec_harness       command line: raw float32 files in, raw float32 file out
+ *   libaecharness.so  the same backend as a tiny C API, driven from Python
+ *                     (stage_model.py / tune.py) through ctypes
+ *
+ * Command line:
+ *   aec_harness --near mic.f32 --far far.f32 --out out.f32 [options]
+ *     --far must already be time-aligned to --near (same length); it is what
+ *     EchoCancellationStage feeds the backend. Options mirror
+ *     SpeexEchoCanceller.Configuration:
+ *     --rate 16000 --frame 160 --filter-ms 300 --residual 1 --supp -40
+ *     --supp-active -15 --denoise 1 --noise-supp 0
+ *   Prints "latency_samples=<n>" and "delay_ms=<x>" on stderr.
+ */
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "speex/speex_echo.h"
+#include "speex/speex_preprocess.h"
+
+typedef struct {
+    int sample_rate;
+    int frame_size;
+    int filter_length;      /* samples, multiple of frame_size */
+    int residual;           /* run the preprocessor for residual echo suppression */
+    int supp, supp_active;  /* residual echo suppression, dB */
+    int denoise;            /* SPEEX_PREPROCESS_SET_DENOISE */
+    int noise_supp;         /* SPEEX_PREPROCESS_SET_NOISE_SUPPRESS, dB */
+    SpeexEchoState *echo;
+    SpeexPreprocessState *pre;
+    spx_int16_t *near_i16, *far_i16, *out_i16;
+    spx_int32_t *ir;        /* impulse response scratch (filter_length) */
+    long far_active_frames;
+} aec_t;
+
+static spx_int16_t to_i16(float x)
+{
+    float v = x * 32767.0f;
+    if (v > 32767.0f) v = 32767.0f;
+    if (v < -32768.0f) v = -32768.0f;
+    return (spx_int16_t)lrintf(v);
+}
+
+static void make_pre(aec_t *a)
+{
+    int zero = 0;
+    a->pre = speex_preprocess_state_init(a->frame_size, a->sample_rate);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_ECHO_STATE, a->echo);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_ECHO_SUPPRESS, &a->supp);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_ECHO_SUPPRESS_ACTIVE, &a->supp_active);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_DENOISE, &a->denoise);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_NOISE_SUPPRESS, &a->noise_supp);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_AGC, &zero);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_VAD, &zero);
+    speex_preprocess_ctl(a->pre, SPEEX_PREPROCESS_SET_DEREVERB, &zero);
+}
+
+/* sample_rate/frame_size in Hz/samples; filter_ms rounded UP to whole frames
+ * (same rule as the Swift backend); supp/supp_active/noise_supp in dB. */
+void *aec_create(int sample_rate, int frame_size, int filter_ms, int residual,
+                 int supp, int supp_active, int denoise, int noise_supp)
+{
+    aec_t *a = (aec_t *)calloc(1, sizeof(aec_t));
+    int blocks = (filter_ms * sample_rate / 1000 + frame_size - 1) / frame_size;
+    int rate = sample_rate;
+    if (blocks < 1) blocks = 1;
+    a->sample_rate = sample_rate;
+    a->frame_size = frame_size;
+    a->filter_length = blocks * frame_size;
+    a->residual = residual;
+    a->supp = supp;
+    a->supp_active = supp_active;
+    a->denoise = denoise;
+    a->noise_supp = noise_supp;
+    a->echo = speex_echo_state_init(frame_size, a->filter_length);
+    if (!a->echo) { free(a); return NULL; }
+    speex_echo_ctl(a->echo, SPEEX_ECHO_SET_SAMPLING_RATE, &rate);
+    if (residual) make_pre(a);
+    a->near_i16 = (spx_int16_t *)calloc((size_t)frame_size, sizeof(spx_int16_t));
+    a->far_i16 = (spx_int16_t *)calloc((size_t)frame_size, sizeof(spx_int16_t));
+    a->out_i16 = (spx_int16_t *)calloc((size_t)frame_size, sizeof(spx_int16_t));
+    a->ir = (spx_int32_t *)calloc((size_t)a->filter_length, sizeof(spx_int32_t));
+    return a;
+}
+
+void aec_destroy(void *h)
+{
+    aec_t *a = (aec_t *)h;
+    if (!a) return;
+    if (a->pre) speex_preprocess_state_destroy(a->pre);
+    speex_echo_state_destroy(a->echo);
+    free(a->near_i16); free(a->far_i16); free(a->out_i16); free(a->ir);
+    free(a);
+}
+
+void aec_reset(void *h)
+{
+    aec_t *a = (aec_t *)h;
+    speex_echo_state_reset(a->echo);
+    a->far_active_frames = 0;
+    /* The preprocessor has no reset call: recreate it so its noise and
+     * residual-echo history starts clean too (same as the Swift backend). */
+    if (a->pre) {
+        speex_preprocess_state_destroy(a->pre);
+        make_pre(a);
+    }
+}
+
+int aec_latency_samples(void *h)
+{
+    aec_t *a = (aec_t *)h;
+    return a->residual ? a->frame_size : 0;
+}
+
+void aec_process(void *h, const float *near, const float *far, float *out)
+{
+    aec_t *a = (aec_t *)h;
+    int i;
+    float far_ms = 0.0f;
+    for (i = 0; i < a->frame_size; i++) {
+        a->near_i16[i] = to_i16(near[i]);
+        a->far_i16[i] = to_i16(far[i]);
+        far_ms += far[i] * far[i];
+    }
+    /* "far-active" = mean square > 1e-6 (about -60 dBFS RMS) */
+    if (far_ms > 1e-6f * (float)a->frame_size) a->far_active_frames++;
+    speex_echo_cancellation(a->echo, a->near_i16, a->far_i16, a->out_i16);
+    if (a->pre) speex_preprocess_run(a->pre, a->out_i16);
+    for (i = 0; i < a->frame_size; i++)
+        out[i] = (float)a->out_i16[i] / 32768.0f;
+}
+
+/* Echo delay in ms (lag of the strongest filter tap, relative to the aligned
+ * far stream), or -1 before ~2 s of far-active audio. Mirrors the Swift code. */
+double aec_delay_ms(void *h, int require_active_frames)
+{
+    aec_t *a = (aec_t *)h;
+    spx_int32_t n = 0;
+    int i, best = 0;
+    double bestv = -1.0;
+    if (a->far_active_frames < require_active_frames) return -1.0;
+    speex_echo_ctl(a->echo, SPEEX_ECHO_GET_IMPULSE_RESPONSE_SIZE, &n);
+    if (n <= 0 || n > a->filter_length) return -1.0;
+    speex_echo_ctl(a->echo, SPEEX_ECHO_GET_IMPULSE_RESPONSE, a->ir);
+    for (i = 0; i < n; i++) {
+        double v = fabs((double)a->ir[i]);
+        if (v > bestv) { bestv = v; best = i; }
+    }
+    if (bestv <= 0.0) return -1.0;
+    return 1000.0 * (double)best / (double)a->sample_rate;
+}
+
+#ifndef AEC_HARNESS_LIB
+static float *read_f32(const char *path, size_t *count)
+{
+    FILE *f = fopen(path, "rb");
+    long bytes;
+    float *buf;
+    if (!f) { perror(path); exit(2); }
+    fseek(f, 0, SEEK_END);
+    bytes = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    buf = (float *)malloc((size_t)bytes + 4);
+    if (fread(buf, 1, (size_t)bytes, f) != (size_t)bytes) { perror("read"); exit(2); }
+    fclose(f);
+    *count = (size_t)bytes / sizeof(float);
+    return buf;
+}
+
+int main(int argc, char **argv)
+{
+    const char *near_p = NULL, *far_p = NULL, *out_p = NULL;
+    int rate = 16000, frame = 160, filter_ms = 300, residual = 1;
+    int supp = -40, supp_active = -15, denoise = 1, noise_supp = 0;
+    int k;
+    for (k = 1; k + 1 < argc; k += 2) {
+        const char *key = argv[k], *val = argv[k + 1];
+        if (!strcmp(key, "--near")) near_p = val;
+        else if (!strcmp(key, "--far")) far_p = val;
+        else if (!strcmp(key, "--out")) out_p = val;
+        else if (!strcmp(key, "--rate")) rate = atoi(val);
+        else if (!strcmp(key, "--frame")) frame = atoi(val);
+        else if (!strcmp(key, "--filter-ms")) filter_ms = atoi(val);
+        else if (!strcmp(key, "--residual")) residual = atoi(val);
+        else if (!strcmp(key, "--supp")) supp = atoi(val);
+        else if (!strcmp(key, "--supp-active")) supp_active = atoi(val);
+        else if (!strcmp(key, "--denoise")) denoise = atoi(val);
+        else if (!strcmp(key, "--noise-supp")) noise_supp = atoi(val);
+        else { fprintf(stderr, "unknown option %s\n", key); return 2; }
+    }
+    if (!near_p || !far_p || !out_p) {
+        fprintf(stderr, "usage: aec_harness --near mic.f32 --far far.f32 --out out.f32 [options]\n");
+        return 2;
+    }
+    {
+        size_t nn, nf, i;
+        float *near = read_f32(near_p, &nn);
+        float *far = read_f32(far_p, &nf);
+        size_t n = nn < nf ? nn : nf;
+        size_t frames = n / (size_t)frame;
+        float *out = (float *)calloc(nn + (size_t)frame, sizeof(float));
+        void *h = aec_create(rate, frame, filter_ms, residual, supp, supp_active, denoise, noise_supp);
+        FILE *fo;
+        if (!h) { fprintf(stderr, "init failed\n"); return 1; }
+        for (i = 0; i < frames; i++)
+            aec_process(h, near + i * (size_t)frame, far + i * (size_t)frame, out + i * (size_t)frame);
+        fo = fopen(out_p, "wb");
+        fwrite(out, sizeof(float), frames * (size_t)frame, fo);
+        fclose(fo);
+        fprintf(stderr, "frames=%zu latency_samples=%d delay_ms=%.1f\n", frames,
+                aec_latency_samples(h), aec_delay_ms(h, 200));
+        aec_destroy(h);
+        free(near); free(far); free(out);
+    }
+    return 0;
+}
+#endif
diff --git a/Packages/EchoCancellation/Tools/linux-harness/backend.py b/Packages/EchoCancellation/Tools/linux-harness/backend.py
new file mode 100644
index 0000000..a8b750d
--- /dev/null
+++ b/Packages/EchoCancellation/Tools/linux-harness/backend.py
@@ -0,0 +1,97 @@
+"""ctypes binding for libaecharness.so (see aec_harness.c): the same Speex echo
+canceller + preprocessor pipeline as Sources/EchoCancellation/SpeexEchoCanceller.swift.
+
+Environment: AEC_HARNESS_LIB = path to libaecharness.so (default: ./build/libaecharness.so
+next to the current directory, as produced by build.sh build).
+"""
+from __future__ import annotations
+
+import ctypes
+import os
+from dataclasses import dataclass
+
+import numpy as np
+
+
+@dataclass
+class BackendConfig:
+    """Mirrors SpeexEchoCanceller.Configuration (plus the denoise/noise knobs
+    discussed in TUNING.md)."""
+    sample_rate: int = 16000
+    frame_size: int = 160
+    filter_length_ms: int = 300
+    residual_echo_suppression: bool = True
+    echo_suppress_db: int = -40
+    echo_suppress_active_db: int = -15
+    # Speex only applies its residual-echo gain when SET_DENOISE is on, so
+    # "noise suppression off" means denoise on with a 0 dB noise floor.
+    denoise: bool = True
+    noise_suppress_db: int = 0
+
+
+_lib = None
+
+
+def _load():
+    global _lib
+    if _lib is not None:
+        return _lib
+    path = os.environ.get("AEC_HARNESS_LIB", os.path.join("build", "libaecharness.so"))
+    lib = ctypes.CDLL(path)
+    lib.aec_create.restype = ctypes.c_void_p
+    lib.aec_create.argtypes = [ctypes.c_int] * 8
+    lib.aec_destroy.argtypes = [ctypes.c_void_p]
+    lib.aec_reset.argtypes = [ctypes.c_void_p]
+    lib.aec_latency_samples.restype = ctypes.c_int
+    lib.aec_latency_samples.argtypes = [ctypes.c_void_p]
+    lib.aec_process.argtypes = [ctypes.c_void_p] + [ctypes.c_void_p] * 3
+    lib.aec_delay_ms.restype = ctypes.c_double
+    lib.aec_delay_ms.argtypes = [ctypes.c_void_p, ctypes.c_int]
+    _lib = lib
+    return lib
+
+
+class Backend:
+    def __init__(self, cfg: BackendConfig | None = None) -> None:
+        self.cfg = cfg or BackendConfig()
+        c = self.cfg
+        self.lib = _load()
+        self.h = self.lib.aec_create(
+            c.sample_rate, c.frame_size, c.filter_length_ms,
+            int(c.residual_echo_suppression), c.echo_suppress_db, c.echo_suppress_active_db,
+            int(c.denoise), c.noise_suppress_db)
+        if not self.h:
+            raise RuntimeError("aec_create failed")
+        self.frame_size = c.frame_size
+        self.latency_samples = self.lib.aec_latency_samples(self.h)
+
+    def __del__(self) -> None:
+        h = getattr(self, "h", None)
+        if h:
+            self.lib.aec_destroy(h)
+            self.h = None
+
+    def reset(self) -> None:
+        self.lib.aec_reset(self.h)
+
+    def process(self, near: np.ndarray, far: np.ndarray, out: np.ndarray) -> None:
+        """near/far/out: float32 contiguous arrays of exactly frame_size."""
+        self.lib.aec_process(self.h, near.ctypes.data, far.ctypes.data, out.ctypes.data)
+
+    def delay_ms(self) -> float | None:
+        d = self.lib.aec_delay_ms(self.h, 200)
+        return None if d < 0 else d
+
+    def run(self, near: np.ndarray, far_aligned: np.ndarray) -> np.ndarray:
+        """Offline helper: run whole signals (already time-aligned, same length)
+        and return the raw backend output (delayed by latency_samples if the
+        residual suppressor is on). Trailing partial frames are dropped."""
+        n = self.frame_size
+        frames = min(len(near), len(far_aligned)) // n
+        near = np.ascontiguousarray(near[:frames * n], dtype=np.float32)
+        far = np.ascontiguousarray(far_aligned[:frames * n], dtype=np.float32)
+        out = np.zeros(frames * n, dtype=np.float32)
+        for i in range(frames):
+            s = i * n
+            self.process(near[s:s + n], far[s:s + n], out[s:s + n])
+        return out
diff --git a/Packages/EchoCancellation/Tools/linux-harness/build.sh b/Packages/EchoCancellation/Tools/linux-harness/build.sh
new file mode 100644
index 0000000..b9cb34e
--- /dev/null
+++ b/Packages/EchoCancellation/Tools/linux-harness/build.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+# Build the tuning harness from the vendored SpeexDSP sources (float build,
+# kiss FFT) and aec_harness.c.
+#
+#   Tools/linux-harness/build.sh <build-dir> [extra cc flags, e.g. -O0]
+#
+# The build directory must be OUTSIDE the vendored tree (objects are never
+# written next to the sources). Produces
+#   <build-dir>/aec_harness       command-line tool (raw float32 in/out)
+#   <build-dir>/libaecharness.so  same backend as a C API for ctypes (Python)
+# (use .dylib naming on macOS: pass the output name via AEC_LIB_NAME).
+set -eu
+
+out="${1:?usage: build.sh <build-dir> [extra cc flags]}"
+shift
+here="$(cd "$(dirname "$0")" && pwd)"
+vendor="$here/../../Sources/CSpeexDSP"
+lib="${AEC_LIB_NAME:-libaecharness.so}"
+opt="-O2"
+if [ "$#" -gt 0 ]; then opt="$*"; fi
+
+mkdir -p "$out"
+srcs="$vendor/mdf.c $vendor/preprocess.c $vendor/fftwrap.c $vendor/kiss_fft.c $vendor/kiss_fftr.c $vendor/filterbank.c"
+flags="-std=gnu11 -Wall -DHAVE_CONFIG_H -DCSPEEXDSP_KEEP_WARNINGS -I$vendor -I$vendor/include"
+
+# shellcheck disable=SC2086
+cc $opt $flags "$here/aec_harness.c" $srcs -lm -o "$out/aec_harness"
+# shellcheck disable=SC2086
+cc $opt $flags -shared -fPIC -DAEC_HARNESS_LIB "$here/aec_harness.c" $srcs -lm -o "$out/$lib"
+echo "built $out/aec_harness and $out/$lib ($opt)"
diff --git a/Packages/EchoCancellation/Tools/linux-harness/calibrate_tests.py b/Packages/EchoCancellation/Tools/linux-harness/calibrate_tests.py
new file mode 100644
index 0000000..f960e68
--- /dev/null
+++ b/Packages/EchoCancellation/Tools/linux-harness/calibrate_tests.py
@@ -0,0 +1,261 @@
+#!/usr/bin/env python3
+"""Measures exactly the quantities the Swift XCTest suite asserts, on the same
+24 s synthetic scenario, so the thresholds in the tests can be justified (and
+re-derived if the signals or defaults change).
+
+    cd Packages/EchoCancellation/Tools/linux-harness
+    sh build.sh build && python3 calibrate_tests.py --lib build/libaecharness.so
+
+Each row: test, metric, measured value, threshold used in the Swift test.
+"""
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import time
+from typing import List
+
+import numpy as np
+
+import synth
+import tune
+import stage_scenarios as ss
+from backend import Backend, BackendConfig
+
+SR = tune.SR
+S = 24                                     # seconds in the shared scenario
+rows: List[List[str]] = []
+
+
+def row(test: str, metric: str, value, threshold: str) -> None:
+    v = f"{value:.3f}" if isinstance(value, float) else str(value)
+    rows.append([test, metric, v, threshold])
+
+
+def corr(a, b) -> float:
+    a = np.asarray(a, dtype=np.float64)
+    b = np.asarray(b, dtype=np.float64)
+    return float(np.dot(a, b) / math.sqrt(np.dot(a, a) * np.dot(b, b)))
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lib", default=os.path.join("build", "libaecharness.so"))
+    args = ap.parse_args()
+    os.environ["AEC_HARNESS_LIB"] = args.lib
+    cfg = BackendConfig()
+
+    far = tune.far_signal(S)
+    near = tune.near_signal(S)
+    noise = tune.noise_signal(S)
+    echo = tune.echo_signal(S)
+    far_al = tune.aligned_far(S)
+    mic = echo + noise
+
+    # ---- SpeexEchoCancellerTests -------------------------------------------------
+    out, delay = tune.run_backend(cfg, mic, far_al)
+    row("backend far-only", "ERLE 12-24 s", tune.erle(mic, out, far_al, 12, 24), ">= 12")
+    row("backend far-only", "ERLE 6-12 s", tune.erle(mic, out, far_al, 6, 12), "(not asserted)")
+    row("backend far-only", "delay estimate (ms)", delay, "70 +- 10")
+
+    n20 = 20 * SR
+    nm = (near + noise)[:n20]
+    o_on, _ = tune.run_backend(cfg, nm, np.zeros(n20, dtype=np.float32))
+    ref = synth.dc_notch(nm)
+    a, b = ref[2 * SR:].astype(np.float64), o_on[2 * SR:].astype(np.float64)
+    row("backend near-only", "SNR vs DC-notched input (dB)", tune.db(tune.energy(a) / tune.energy(b - a)), ">= 25")
+    row("backend near-only", "energy vs DC-notched input (dB)", tune.db(tune.energy(b) / tune.energy(a)), "abs(x) <= 1")
+    row("backend near-only", "correlation vs DC-notched", corr(a, b), ">= 0.999")
+
+    ideal, _ = tune.run_backend(cfg, near + noise, np.zeros(S * SR, dtype=np.float32))
+    dt_mic = near + echo + noise
+    o_dt, _ = tune.run_backend(cfg, dt_mic, far_al)
+    s, e = 12 * SR, S * SR
+    dt = (tune.active_mask(near) & tune.active_mask(echo))[s:e]
+    o, i, ec = o_dt[s:e][dt].astype(np.float64), ideal[s:e][dt].astype(np.float64), echo[s:e][dt].astype(np.float64)
+    g = float(np.dot(o, i) / np.dot(i, i))
+    row("backend double-talk", "DT fraction", float(dt.mean()), "(info)")
+    row("backend double-talk", "retention gain (dB)", 20 * math.log10(abs(g)), "abs(x) <= 1.5")
+    row("backend double-talk", "correlation vs ideal", corr(o, i), ">= 0.90")
+    row("backend double-talk", "(out-ideal) vs echo (dB)", tune.db(tune.energy(o - i) / tune.energy(ec)), "<= -6")
+
+    # reset
+    b1 = Backend(cfg)
+    b2 = Backend(cfg)
+    nfr = 160
+    def run_frames(b, lo_s, hi_s, out_arr):
+        for k in range(int(lo_s * SR) // nfr, int(hi_s * SR) // nfr):
+            sl = slice(k * nfr, (k + 1) * nfr)
+            b.process(np.ascontiguousarray(mic[sl]), np.ascontiguousarray(far_al[sl]), out_arr[sl])
+    oa = np.zeros(S * SR, dtype=np.float32)
+    ob = np.zeros(S * SR, dtype=np.float32)
+    run_frames(b1, 0, 12, oa)
+    run_frames(b2, 0, 12, ob)
+    b2.reset()
+    row("backend reset", "delay estimate right after reset", b2.delay_ms(), "nil")
+    run_frames(b1, 12, 14, oa)
+    run_frames(b2, 12, 14, ob)
+    L = b1.latency_samples
+    oa2 = np.concatenate([oa[L:], np.zeros(L, dtype=np.float32)])
+    ob2 = np.concatenate([ob[L:], np.zeros(L, dtype=np.float32)])
+    ea = tune.erle(mic, oa2, far_al, 12, 14)
+    eb = tune.erle(mic, ob2, far_al, 12, 14)
+    row("backend reset", "ERLE 12-14 s without reset", ea, "(info)")
+    row("backend reset", "ERLE 12-14 s with reset at 12 s", eb, "<= without - 6")
+    run_frames(b2, 14, S, ob)
+    ob2 = np.concatenate([ob[L:], np.zeros(L, dtype=np.float32)])
+    row("backend reset", "ERLE 20-24 s (re-converged)", tune.erle(mic, ob2, far_al, 20, 24), ">= 8")
+
+    b3 = Backend(cfg)
+    one_s = np.zeros(S * SR, dtype=np.float32)
+    for k in range(0, 100):
+        sl = slice(k * nfr, (k + 1) * nfr)
+        b3.process(np.ascontiguousarray(mic[sl]), np.ascontiguousarray(far_al[sl]), one_s[sl])
+    row("backend delay", "estimate after 1 s", b3.delay_ms(), "nil")
+    for d in (0, 120, 200):
+        n14 = 14 * SR      # first 14 s of the shared scenario, like the Swift test
+        echo_d = synth.convolve(far[:n14], tune.rir(delay_ms=float(d)))
+        mic_d = echo_d + noise[:n14]
+        _, dd = tune.run_backend(cfg, mic_d, far_al[:n14])
+        row("backend delay", f"estimate, true delay {d} ms, at 14 s", dd, f"{d + 30} +- 10")
+
+    nl_echo = tune.echo_signal(S, nonlinear=True)
+    nl_mic = nl_echo + noise
+    o_nl, _ = tune.run_backend(cfg, nl_mic, far_al)
+    row("backend nonlinear", "ERLE 12-24 s", tune.erle(nl_mic, o_nl, far_al, 12, 24), ">= 6")
+
+    # ---- EchoCancellationStageTests -----------------------------------------------
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, mic, far)
+    stt = st.statistics
+    row("stage chunked+ts", "length conserved", len(out) == len(mic), "true")
+    row("stage chunked+ts", "ERLE 12-24 s", tune.erle(mic, out, far, 12, 24), ">= 12")
+    row("stage chunked+ts", "stat echoReductionDb", stt.echo_reduction_db, ">= 10")
+    row("stage chunked+ts", "stat estimatedEchoDelayMs", stt.estimated_echo_delay_ms, "70 +- 10")
+    row("stage chunked+ts", "stat offset (ms)", stt.initial_mic_to_reference_offset_ms, "abs(x) < 1")
+    row("stage chunked+ts", "framesProcessed", stt.frames_processed, f"== {len(mic) // 160 + 1}")
+    row("stage chunked+ts", "framesWithReference", stt.frames_with_reference, "> 0.25 * processed")
+    row("stage chunked+ts", "micReanchors/refReanchors", f"{stt.mic_reanchors}/{stt.reference_reanchors}", "0/0")
+
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, mic, far, skip_silent_ref=True)
+    stt = st.statistics
+    row("stage SCK silence", "ERLE 12-24 s", tune.erle(mic, out, far, 12, 24), ">= 12")
+    row("stage SCK silence", "referenceReanchors", stt.reference_reanchors, ">= 1")
+
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, mic, far, ref_late_ms=60)
+    row("stage ref 60ms late", "ERLE 12-24 s", tune.erle(mic, out, far, 12, 24), ">= 12")
+    row("stage ref 60ms late", "length conserved", len(out) == len(mic), "true")
+    row("stage ref 60ms late", "referenceSamplesDiscarded", st.statistics.reference_samples_discarded, "== 0")
+
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, mic, far, use_ts=False)
+    row("stage contiguous", "ERLE 12-24 s", tune.erle(mic, out, far, 12, 24), ">= 12")
+    row("stage contiguous", "offset stat", st.statistics.initial_mic_to_reference_offset_ms, "nil")
+
+    # gaps
+    gaps = [(12.0, 14.5), (19.0, 20.2)]
+    gfar = ss.gappy_far(S, gaps)
+    gecho = synth.convolve(gfar, tune.rir())
+    gmic = gecho + noise
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, gmic, gfar, skip_silent_ref=True)
+    row("stage gaps", "length conserved", len(out) == len(gmic), "true")
+    row("stage gaps", "ERLE 8-12 s (before)", tune.erle(gmic, out, gfar, 8, 12), "(info)")
+    row("stage gaps", "ERLE 15.0-17.5 s (0.5-3 s after resume)", tune.erle(gmic, out, gfar, 15.0, 17.5), ">= 12")
+    row("stage gaps", "ERLE 20.7-23.2 s (0.5-3 s after resume 2)", tune.erle(gmic, out, gfar, 20.7, 23.2), ">= 12")
+    row("stage gaps", "referenceReanchors", st.statistics.reference_reanchors, ">= 2")
+
+    # mic jumps
+    cut0, cut1 = int(10.0 * SR), int(10.35 * SR)
+    dup_at, dup = int(16.0 * SR), int(0.2 * SR)
+    mic2 = np.concatenate([mic[:cut0], mic[cut1:dup_at], mic[dup_at - dup:]])
+    far2 = np.concatenate([far[:cut0], far[cut1:dup_at], far[dup_at - dup:]])
+    true_idx = np.concatenate([np.arange(0, cut0), np.arange(cut1, dup_at), np.arange(dup_at - dup, len(mic))])
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, mic2, far, mic_true_idx=true_idx)
+    row("stage mic jumps", "length conserved", len(out) == len(mic2), "true")
+    row("stage mic jumps", "micReanchors", st.statistics.mic_reanchors, "== 2")
+    row("stage mic jumps", "ERLE 17-23 s", tune.erle(mic2, out, far2, 17, 23), ">= 12")
+
+    # no reference
+    nm24 = near + noise
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, nm24, np.zeros(0, dtype=np.float32))
+    exp = synth.dc_notch(nm24)
+    row("stage no reference", "length conserved", len(out) == len(nm24), "true")
+    row("stage no reference", "correlation vs DC-notched input", corr(out, exp), "> 0.999")
+    row("stage no reference", "energy vs input (dB)", tune.db(tune.energy(out) / tune.energy(nm24)), "abs(x) < 1")
+
+    tones = synth.multitone(5, 8.0)
+    tmic = tones + noise[:len(tones)]
+    st = ss.make_stage(cfg)
+    out = ss.feed(st, tmic, np.zeros(0, dtype=np.float32))
+    row("stage no reference (multitone)", "correlation vs raw input", corr(out, tmic), "> 0.99")
+    row("stage no reference (multitone)", "energy vs input (dB)", tune.db(tune.energy(out) / tune.energy(tmic)), "abs(x) < 1")
+
+    # absurd basis
+    st = ss.make_stage(cfg)
+    n10 = 10 * SR
+    out = ss.feed(st, mic[:n10], far[:n10], base=1.0e6, ref_base=5.0)
+    row("stage absurd basis", "length conserved", len(out) == n10, "true")
+    row("stage absurd basis", "offset stat (ms)", st.statistics.initial_mic_to_reference_offset_ms, "~ 1e9")
+    row("stage absurd basis", "framesWithReference", st.statistics.frames_with_reference, "== 0")
+
+    # random chunking equality
+    sig = (near + noise)[:10 * SR]
+    refsig = far[:10 * SR]
+    def run_ref_first(sizes):
+        stg = ss.make_stage(cfg)
+        stg.append_reference(refsig, ss.BASE)
+        outs = []
+        pos, k = 0, 0
+        while pos < len(sig):
+            size = sizes[k % len(sizes)]
+            k += 1
+            c = sig[pos:pos + size]
+            outs.append(stg.process_microphone(c, ss.BASE + pos / SR))
+            pos += len(c)
+        outs.append(stg.flush())
+        return np.concatenate(outs)
+    canon = run_ref_first([160])
+    same = 0
+    for seed in range(4):
+        r = np.random.default_rng(seed)
+        o2 = run_ref_first(list(r.integers(1, 4000, size=300)))
+        same += int(np.array_equal(o2, canon))
+    row("stage random chunking", "identical to 160-sample chunking (of 4 seeds)", same, "== 4")
+
+    # pause / resume
+    st = ss.make_stage(cfg)
+    outs = []
+    half = 12 * SR
+    ev1 = ss.feed(st, mic[:half], far[:half])
+    # feed() already flushed; now resume 30 s later on both streams
+    st.reset_timeline(reset_filter=False)
+    ev2 = ss.feed(st, mic[half:], far[half:], base=ss.BASE + 30.0 + 12.0)
+    o_all = np.concatenate([ev1, ev2])
+    row("stage pause/resume", "length conserved", len(o_all) == len(mic), "true")
+    row("stage pause/resume", "ERLE 14-24 s (filter kept)", tune.erle(mic, o_all, far, 14, 24), ">= 12")
+    st = ss.make_stage(cfg)
+    ev1 = ss.feed(st, mic[:half], far[:half])
+    st.reset_timeline(reset_filter=True)
+    ev2 = ss.feed(st, mic[half:], far[half:], base=ss.BASE + 30.0 + 12.0)
+    o_all = np.concatenate([ev1, ev2])
+    row("stage pause/resume", "ERLE 12-14 s after resetFilter:true", tune.erle(mic, o_all, far, 12, 14), "< 12")
+
+    # throughput
+    far60 = np.concatenate([far, far, far[:12 * SR]])
+    mic60 = np.concatenate([mic, mic, mic[:12 * SR]])
+    st = ss.make_stage(cfg)
+    t = time.time()
+    out = ss.feed(st, mic60, far60)
+    row("stage throughput (python model)", "wall time for 60 s (s)", time.time() - t, "n/a (Swift: < 5)")
+
+    print(tune.table(["test", "metric", "measured", "Swift threshold"], rows))
+
+
+if __name__ == "__main__":
+    main()
