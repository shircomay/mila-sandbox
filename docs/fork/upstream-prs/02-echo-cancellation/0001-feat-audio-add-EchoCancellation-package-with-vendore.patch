+import Foundation
+
+/// Cancels the meeting app's audio (the reference) out of the microphone
+/// signal, aligning the two streams by host time.
+///
+/// Why host time: Mila pairs microphone and app audio by arrival order, and
+/// ScreenCaptureKit stops delivering buffers while the app is silent, so the
+/// mic/app offset jumps every time the far end goes quiet. An adaptive echo
+/// filter cannot track that. This stage places both streams on one integer
+/// sample timeline (position p <-> host time t0 + p / sampleRate), feeds the
+/// reference to the backend at the position the microphone frame was
+/// *captured*, and treats spans where the reference never arrived as silence.
+///
+/// Per stream the stage keeps a predicted position for the next sample and
+/// follows the sample count, not the timestamp jitter; a timestamp further than
+/// `reanchorToleranceMs` from the prediction re-anchors the stream (gap,
+/// overlap, device change).
+///
+/// Microphone samples are held in a FIFO and processed in whole backend frames
+/// as soon as the reference for the frame has arrived, or after `holdMs`. They
+/// are never inserted, dropped or reordered: across a session (including
+/// `flush()`) the total output length equals the total input length.
+///
+/// Not thread-safe: the caller serialises all calls (the app calls from the
+/// main actor). Not `Sendable`.
+public final class EchoCancellationStage {
+    public struct Configuration: Equatable, Sendable {
+        public var sampleRate: Double = 16_000
+        /// Max time a mic frame waits for its reference to arrive.
+        public var holdMs: Double = 150
+        /// Feed the reference this far AHEAD of mic time, so a reference
+        /// timestamp that is slightly late is still causal for the filter.
+        public var referenceLeadMs: Double = 30
+        /// A timestamp further than this from the sample-count prediction
+        /// re-anchors the stream (gap, overlap, device change).
+        public var reanchorToleranceMs: Double = 20
+        /// Reference history retained (ring buffer length). Clamped to 1...60 s.
+        public var referenceRetentionSeconds: Double = 10
+        public var backend: SpeexEchoCanceller.Configuration = .init()
+
+        public init() {}
+    }
+
+    public struct Statistics: Equatable, Sendable {
+        public var framesProcessed: Int = 0
+        /// Far frame had any non-zero sample.
+        public var framesWithReference: Int = 0
+        /// Processed on hold timeout with missing reference.
+        public var framesHeldTooLong: Int = 0
+        public var micReanchors: Int = 0
+        public var referenceReanchors: Int = 0
+        /// Arrived too late (after the mic frame that needed them was processed) or beyond retention.
+        public var referenceSamplesDiscarded: Int = 0
+        /// Rolling ERLE over far-active frames that do not look like double talk.
+        public var echoReductionDb: Double?
+        /// From the backend: lag of the filter's strongest tap behind the reference
+        /// the backend was fed. Includes `referenceLeadMs`; subtract it for the
+        /// echo delay on the shared timeline.
+        public var estimatedEchoDelayMs: Double?
+        /// First mic timestamp minus first reference timestamp, in ms.
+        public var initialMicToReferenceOffsetMs: Double?
+
+        public init() {}
+    }
+
+    public let configuration: Configuration
+    public private(set) var statistics = Statistics()
+
+    /// Debug tap, for dumping what the stage saw and produced. nil by default
+    /// and free when nil; set it only for debug dumps (it allocates per call).
+    ///
+    /// Each call passes three arrays of equal length k, 1 <= k <= the backend's
+    /// frame size. `out` is exactly the next k samples the stage hands to its
+    /// caller (from `processMicrophone`, `flush()`, or the output a
+    /// `resetTimeline` flushes and the next call returns), after the backend's
+    /// latency is compensated. `near` is the microphone input those samples
+    /// were computed from, and `far` the aligned reference the backend was fed
+    /// for them, so the three arrays are parallel, sample for sample.
+    ///
+    /// Over a session the concatenated `out` equals everything returned by
+    /// `processMicrophone` and `flush()`, in order, and the concatenated `near`
+    /// equals all the microphone input. The silence frames the stage feeds
+    /// internally to drain a backend's latency, and the zero padding of a final
+    /// partial frame, contribute no samples. Calls happen when the samples
+    /// leave the backend path, inside `processMicrophone`/`flush()`/
+    /// `resetTimeline`, never later. Set it before the first microphone sample;
+    /// samples that were produced while it was nil are not reported.
+    public var frameObserver: ((_ near: [Float], _ far: [Float], _ out: [Float]) -> Void)?
+
+    // Timestamps further than this from t0 (in samples) are ignored as absurd.
+    private static let maxTimestampSpanSamples = 4.0e15
+    // Far frames below this mean square (about -60 dBFS RMS) are not "far-active".
+    private static let farActiveMeanSquare = 1e-6
+    private static let statisticsRefreshFrames = 50
+    // Upper bound on frames fed to drain the backend's latency at flush.
+    private static let maxDrainFrames = 64
+
+    private let backend: EchoCancellerBackend
+    private let sampleRate: Double
+    private let frameSize: Int
+    private let latency: Int
+    private let leadSamples: Int
+    private let toleranceSamples: Int
+    private let holdSamples: Int
+
+    // Timeline.
+    private var t0: Double?
+    private var micTimeline = StreamTimeline()
+    private var referenceTimeline = StreamTimeline()
+    private var ring: ReferenceRing
+    /// End (exclusive) of the reference span read by the most recent frame; reference
+    /// arriving below it came too late to be used. nil after a mic re-anchor/reset.
+    private var consumedReferenceEnd: Int?
+
+    // Microphone side.
+    private var micQueue = MicQueue()
+    private var totalIn = 0
+    private var totalReturned = 0
+    /// Backend output that is ready but not yet handed to the caller.
+    private var produced: [Float] = []
+    /// Output samples still to drop to compensate the backend's latency.
+    private var skipRemaining: Int
+    /// Output flushed by `resetTimeline`, handed out by the next call.
+    private var carry: [Float] = []
+
+    // Observer bookkeeping (used only while `frameObserver` is set). Real mic
+    // samples fed to the backend, with the far samples fed alongside, that have
+    // not been reported yet: `pendingNear[i]` is the real input sample number
+    // `pendingFirstIndex + i` (numbered from the start of the stage's life,
+    // like `totalReturned`, which numbers the output samples the same way).
+    private var realFed = 0
+    private var pendingNear: [Float] = []
+    private var pendingFar: [Float] = []
+    private var pendingFirstIndex = 0
+
+    // Preallocated frame buffers.
+    private let nearFrame: UnsafeMutablePointer<Float>
+    private let farFrame: UnsafeMutablePointer<Float>
+    private let outFrame: UnsafeMutablePointer<Float>
+
+    private var reduction = EchoReductionTracker()
+    private var framesSinceRefresh = 0
+
+    /// `backend` nil -> a SpeexEchoCanceller with `configuration.backend`.
+    /// Returns nil only if the backend cannot be created.
+    public init?(configuration: Configuration = .init(), backend: EchoCancellerBackend? = nil) {
+        let resolved: EchoCancellerBackend
+        if let backend {
+            resolved = backend
+        } else if let speex = SpeexEchoCanceller(configuration: configuration.backend) {
+            resolved = speex
+        } else {
+            return nil
+        }
+        let frameSize = resolved.frameSize
+        let sampleRate = configuration.sampleRate
+        guard frameSize > 0, sampleRate.isFinite, sampleRate > 0 else { return nil }
+
+        let lead = EchoCancellationStage.samples(ms: configuration.referenceLeadMs, sampleRate: sampleRate, limit: 10_000)
+        let tolerance = EchoCancellationStage.samples(ms: configuration.reanchorToleranceMs, sampleRate: sampleRate, limit: 10_000)
+        let hold = EchoCancellationStage.samples(ms: configuration.holdMs, sampleRate: sampleRate, limit: 10_000)
+        let retention = EchoCancellationStage.samples(ms: configuration.referenceRetentionSeconds * 1000,
+                                                      sampleRate: sampleRate, limit: 60_000)
+        let latency = max(0, resolved.latencySamples)
+
+        self.configuration = configuration
+        self.backend = resolved
+        self.sampleRate = sampleRate
+        self.frameSize = frameSize
+        self.latency = latency
+        self.leadSamples = lead
+        self.toleranceSamples = max(1, tolerance)
+        self.holdSamples = max(frameSize, hold)
+        self.ring = ReferenceRing(capacity: max(retention, 4 * (lead + frameSize)))
+        self.skipRemaining = latency
+
+        let near = UnsafeMutablePointer<Float>.allocate(capacity: frameSize)
+        near.initialize(repeating: 0, count: frameSize)
+        let far = UnsafeMutablePointer<Float>.allocate(capacity: frameSize)
+        far.initialize(repeating: 0, count: frameSize)
+        let out = UnsafeMutablePointer<Float>.allocate(capacity: frameSize)
+        out.initialize(repeating: 0, count: frameSize)
+        self.nearFrame = near
+        self.farFrame = far
+        self.outFrame = out
+    }
+
+    deinit {
+        nearFrame.deallocate()
+        farFrame.deallocate()
+        outFrame.deallocate()
+    }
+
+    /// Milliseconds -> whole samples, rounded, clamped to 0...limit-in-ms worth of samples.
+    private static func samples(ms: Double, sampleRate: Double, limit: Double) -> Int {
+        guard ms.isFinite else { return 0 }
+        let clamped = min(max(ms, 0), limit)
+        return Int((clamped * sampleRate / 1000).rounded())
+    }
+
+    // MARK: - Reference (far-end) audio
+
+    /// Far-end (app) audio. `hostTimeSeconds` = time of `samples[0]` on the
+    /// shared monotonic host clock; nil = contiguous with the previous call.
+    public func appendReference(_ samples: [Float], hostTimeSeconds: Double?) {
+        let placement = place(hostTimeSeconds, on: referenceTimeline)
+        referenceTimeline = placement.timeline
+        if placement.reanchored {
+            statistics.referenceReanchors += 1
+        }
+        if placement.firstTimestamp {
+            updateInitialOffset()
+        }
+        guard !samples.isEmpty else { return }
+
+        let start = referenceTimeline.next
+        referenceTimeline.next += samples.count
+        let result = ring.write(samples, at: start)
+        statistics.referenceSamplesDiscarded += result.dropped
+        if let consumed = consumedReferenceEnd, result.storedStart < consumed {
+            // Arrived after the mic frame that needed it was processed.
+            let late = min(start + samples.count, consumed) - result.storedStart
+            if late > 0 {
+                statistics.referenceSamplesDiscarded += late
+            }
+        }
+    }
+
+    // MARK: - Microphone (near-end) audio
+
+    /// Near-end (mic) audio. Returns cleaned mic samples that are ready, in
+    /// order. May return fewer or more samples than passed (held frames), but
+    /// across the whole session (including `flush()`) total output length ==
+    /// total input length, and output order == input order. Never inserts or
+    /// drops mic samples.
+    public func processMicrophone(_ samples: [Float], hostTimeSeconds: Double?) -> [Float] {
+        let placement = place(hostTimeSeconds, on: micTimeline)
+        micTimeline = placement.timeline
+        if placement.reanchored {
+            statistics.micReanchors += 1
+            consumedReferenceEnd = nil
+        }
+        if placement.firstTimestamp {
+            updateInitialOffset()
+        }
+        if !samples.isEmpty {
+            micQueue.append(samples, at: micTimeline.next)
+            micTimeline.next += samples.count
+            totalIn += samples.count
+        }
+        drainQueue(flushing: false)
+        return takeProduced(count: produced.count)
+    }
+
+    /// Process everything still held, treating missing reference as silence.
+    /// Returns exactly the held samples' count (partial last frame zero-padded
+    /// internally, padding dropped from the output). For a backend with
+    /// latency that is the held samples plus the samples still inside the
+    /// backend, so that the session total stays input == output.
+    public func flush() -> [Float] {
+        drainQueue(flushing: true)
+        let owed = totalIn - totalReturned
+        var result: [Float] = []
+        if owed > 0 {
+            // Push silence through to drain the backend's algorithmic latency.
+            nearFrame.update(repeating: 0, count: frameSize)
+            farFrame.update(repeating: 0, count: frameSize)
+            var guardFrames = 0
+            while produced.count < owed && guardFrames < EchoCancellationStage.maxDrainFrames {
+                runBackend(accountStatistics: false, realCount: 0)
+                guardFrames += 1
+            }
+            result = takeProduced(count: owed)
+        }
+        produced.removeAll(keepingCapacity: true)   // padding beyond what is owed
+        pendingNear.removeAll(keepingCapacity: true)
+        pendingFar.removeAll(keepingCapacity: true)
+        skipRemaining = latency                      // the next segment starts a fresh pipeline
+        refreshStatistics()
+        return withCarry(result)
+    }
+
+    /// Drop timeline anchors and pending reference (after pause/resume or a
+    /// capture restart). Held mic samples must be flushed by the caller first
+    /// (if they are not, they are flushed here and returned by the next call,
+    /// so nothing is lost). `resetFilter: true` also resets the backend (echo
+    /// path changed).
+    public func resetTimeline(resetFilter: Bool) {
+        carry = flush()
+        t0 = nil
+        micTimeline = StreamTimeline()
+        referenceTimeline = StreamTimeline()
+        ring.removeAll()
+        consumedReferenceEnd = nil
+        micQueue.removeAll()
+        if resetFilter {
+            backend.reset()
+            reduction.reset()
+            statistics.echoReductionDb = nil
+            statistics.estimatedEchoDelayMs = nil
+        }
+        skipRemaining = latency
+    }
+
+    // MARK: - Timeline
+
+    private struct Placement {
+        var timeline: StreamTimeline
+        var reanchored = false
+        /// This call carried the stream's first usable timestamp.
+        var firstTimestamp = false
+    }
+
+    private func place(_ timestamp: Double?, on timeline: StreamTimeline) -> Placement {
+        var result = Placement(timeline: timeline)
+        guard let ts = timestamp, ts.isFinite else { return result }   // contiguous
+        if t0 == nil {
+            // The first timestamp anywhere defines the time origin; choose it so
+            // that this stream's current position maps to this timestamp.
+            t0 = ts - Double(timeline.next) / sampleRate
+        }
+        let origin = t0 ?? ts
+        let span = (ts - origin) * sampleRate
+        guard span.isFinite, abs(span) <= EchoCancellationStage.maxTimestampSpanSamples else {
+            return result    // absurd timestamp: ignore it, keep counting samples
+        }
+        let measured = Int(span.rounded())
+        if !result.timeline.hasTimestamp {
+            result.timeline.hasTimestamp = true
+            result.timeline.firstTimestamp = ts
+            result.timeline.next = measured
+            result.firstTimestamp = true
+        } else if abs(measured - result.timeline.next) > toleranceSamples {
+            result.timeline.next = measured
+            result.reanchored = true
+        }
+        return result
+    }
+
+    private func updateInitialOffset() {
+        if let mic = micTimeline.firstTimestamp, let reference = referenceTimeline.firstTimestamp {
+            statistics.initialMicToReferenceOffsetMs = (mic - reference) * 1000
+        }
+    }
+
+    // MARK: - Frame processing
+
+    /// Processes whole frames from the head of the mic queue while the
+    /// reference for the frame has arrived, or it has waited `holdMs`.
+    private func drainQueue(flushing: Bool) {
+        while true {
+            let queued = micQueue.count
+            if queued == 0 { break }
+            if queued < frameSize && !flushing { break }
+            guard let position = micQueue.firstPosition else { break }
+            var ready = false
+            if let high = ring.highWater {
+                ready = high >= position + leadSamples + frameSize
+            }
+            let waited = queued >= holdSamples
+            if !(ready || waited || flushing) { break }
+            processHeldFrame(at: position, referenceReady: ready)
+        }
+    }
+
+    private func processHeldFrame(at position: Int, referenceReady: Bool) {
+        let real = micQueue.pop(into: nearFrame, max: frameSize)
+        ring.read(from: position + leadSamples, count: frameSize, into: farFrame)
+        var hasReference = false
+        var i = 0
+        while i < frameSize {
+            if farFrame[i] != 0 {
+                hasReference = true
+                break
+            }
+            i += 1
+        }
+        if hasReference {
+            statistics.framesWithReference += 1
+        } else if !referenceReady {
+            statistics.framesHeldTooLong += 1
+        }
+        runBackend(accountStatistics: true, realCount: real)
+        consumedReferenceEnd = position + leadSamples + frameSize
+    }
+
+    /// Runs the backend on nearFrame/farFrame -> outFrame and queues the output.
+    /// `realCount`: how many leading samples of the frame are real microphone
+    /// samples (a full frame, a partial last frame, or 0 for a drain frame).
+    private func runBackend(accountStatistics: Bool, realCount: Int) {
+        backend.process(near: nearFrame, far: farFrame, out: outFrame)
+        statistics.framesProcessed += 1
+        if frameObserver != nil && realCount > 0 {
+            if pendingNear.isEmpty { pendingFirstIndex = realFed }
+            pendingNear.append(contentsOf: UnsafeBufferPointer(start: UnsafePointer(nearFrame), count: realCount))
+            pendingFar.append(contentsOf: UnsafeBufferPointer(start: UnsafePointer(farFrame), count: realCount))
+        }
+        realFed += realCount
+        if accountStatistics {
+            account()
+        }
+        // Compensate the backend's latency: its first `latency` output samples
+        // of a pipeline carry no input yet.
+        var skip = 0
+        if skipRemaining > 0 {
+            skip = min(skipRemaining, frameSize)
+            skipRemaining -= skip
+        }
+        if skip < frameSize {
+            produced.append(contentsOf: UnsafeBufferPointer(start: UnsafePointer(outFrame + skip),
+                                                            count: frameSize - skip))
+        }
+    }
+
+    /// Reports `output` (the samples numbered `start...` that are leaving the
+    /// stage) to the observer, in chunks of at most `frameSize`, paired with
+    /// the real input they were computed from.
+    private func observe(_ output: [Float], startingAt start: Int) {
+        guard let observer = frameObserver else {
+            if !pendingNear.isEmpty {
+                pendingNear.removeAll(keepingCapacity: false)
+                pendingFar.removeAll(keepingCapacity: false)
+            }
+            return
+        }
+        // Input older than this output cannot be paired any more (it was
+        // recorded for output that has already left): forget it.
+        let stale = min(max(0, start - pendingFirstIndex), pendingNear.count)
+        if stale > 0 {
+            pendingNear.removeFirst(stale)
+            pendingFar.removeFirst(stale)
+            pendingFirstIndex += stale
+        }
+        // Output produced before the observer was set has no recorded input.
+        let skip = max(0, pendingFirstIndex - start)
+        let usable = min(output.count - skip, pendingNear.count)
+        guard usable > 0 else { return }
+        var offset = 0
+        while offset < usable {
+            let k = min(frameSize, usable - offset)
+            observer(Array(pendingNear[offset..<(offset + k)]),
+                     Array(pendingFar[offset..<(offset + k)]),
+                     Array(output[(skip + offset)..<(skip + offset + k)]))
+            offset += k
+        }
+        pendingNear.removeFirst(usable)
+        pendingFar.removeFirst(usable)
+        pendingFirstIndex += usable
+    }
+
+    /// Removes and returns the first `count` produced samples.
+    private func takeProduced(count: Int) -> [Float] {
+        let n = min(count, produced.count)
+        let result: [Float]
+        if n == produced.count {
+            result = produced
+            produced.removeAll(keepingCapacity: true)
+        } else {
+            result = Array(produced[0..<n])
+            produced.removeFirst(n)
+        }
+        if n > 0 { observe(result, startingAt: totalReturned) }
+        totalReturned += n
+        return withCarry(result)
+    }
+
+    private func withCarry(_ result: [Float]) -> [Float] {
+        guard !carry.isEmpty else { return result }
+        let joined = carry + result
+        carry.removeAll()
+        return joined
+    }
+
+    // MARK: - Statistics
+
+    private func account() {
+        var nearEnergy = 0.0
+        var farEnergy = 0.0
+        var outEnergy = 0.0
+        var i = 0
+        while i < frameSize {
+            let n = Double(nearFrame[i])
+            let f = Double(farFrame[i])
+            let o = Double(outFrame[i])
+            nearEnergy += n * n
+            farEnergy += f * f
+            outEnergy += o * o
+            i += 1
+        }
+        if farEnergy > EchoCancellationStage.farActiveMeanSquare * Double(frameSize) && nearEnergy > 0 {
+            reduction.add(nearEnergy: nearEnergy, farEnergy: farEnergy, outEnergy: outEnergy)
+        }
+        framesSinceRefresh += 1
+        if framesSinceRefresh >= EchoCancellationStage.statisticsRefreshFrames {
+            refreshStatistics()
+        }
+    }
+
+    private func refreshStatistics() {
+        framesSinceRefresh = 0
+        if let reductionDb = reduction.reductionDb() {
+            statistics.echoReductionDb = reductionDb
+        }
+        statistics.estimatedEchoDelayMs = backend.estimatedEchoDelayMs()
+    }
+}
diff --git a/Packages/EchoCancellation/Sources/EchoCancellation/EchoCancellerBackend.swift b/Packages/EchoCancellation/Sources/EchoCancellation/EchoCancellerBackend.swift
new file mode 100644
index 0000000..38877a6
--- /dev/null
+++ b/Packages/EchoCancellation/Sources/EchoCancellation/EchoCancellerBackend.swift
@@ -0,0 +1,43 @@
+/// A fixed-frame-size acoustic echo canceller: removes the echo of a known
+/// far-end (reference) signal from a near-end (microphone) signal.
+///
+/// The backend knows nothing about time: every call receives a microphone
+/// frame and the reference samples that were played at the same moment
+/// (already aligned by ``EchoCancellationStage``). It is not thread-safe.
+public protocol EchoCancellerBackend: AnyObject {
+    /// Samples per call (10 ms at the configured rate).
+    var frameSize: Int { get }
+
+    /// Cancel `far`'s echo from `near`. Each pointer addresses exactly
+    /// `frameSize` Float samples in [-1, 1]. `out` may not alias the inputs.
+    func process(near: UnsafePointer<Float>, far: UnsafePointer<Float>,
+                 out: UnsafeMutablePointer<Float>)
+
+    /// Forget everything learned (new echo path).
+    func reset()
+
+    /// Diagnostics: estimated echo delay in milliseconds from the adaptive
+    /// filter's strongest tap, or nil if not available / not converged.
+    ///
+    /// The value is the lag between the far-end samples passed to `process`
+    /// and their echo in `near`, so it includes whatever lead the caller
+    /// applied to the reference (``EchoCancellationStage`` feeds the reference
+    /// `referenceLeadMs` ahead; subtract that to get the delay on the shared
+    /// timeline).
+    func estimatedEchoDelayMs() -> Double?
+
+    /// Algorithmic latency, in samples: the output of `process` for frame k
+    /// carries the cleaned samples of frame k - latency/frameSize. A backend
+    /// with a latency delays its output stream; ``EchoCancellationStage``
+    /// compensates (drops the first `latencySamples` output samples and drains
+    /// the same number of samples at `flush()`), so its callers never see it.
+    ///
+    /// It has a default implementation (0), so a backend
+    /// without latency does not need to implement it.
+    var latencySamples: Int { get }
+}
+
+extension EchoCancellerBackend {
+    /// Default: no algorithmic latency.
+    public var latencySamples: Int { 0 }
+}
diff --git a/Packages/EchoCancellation/Sources/EchoCancellation/SpeexEchoCanceller.swift b/Packages/EchoCancellation/Sources/EchoCancellation/SpeexEchoCanceller.swift
new file mode 100644
index 0000000..988d14a
--- /dev/null
+++ b/Packages/EchoCancellation/Sources/EchoCancellation/SpeexEchoCanceller.swift
@@ -0,0 +1,236 @@
+import CSpeexDSP
+
+/// ``EchoCancellerBackend`` built on SpeexDSP's MDF echo canceller (an adaptive
+/// frequency-domain block filter with a foreground/background double path),
+/// optionally followed by Speex's preprocessor, whose only job here is
+/// residual echo suppression.
+///
+/// Tuning rationale and measurements: `TUNING.md` next to `Package.swift`. The
+/// C harness in `Tools/linux-harness/aec_harness.c` mirrors `process(...)`
+/// exactly; keep them in sync.
+public final class SpeexEchoCanceller: EchoCancellerBackend {
+    public struct Configuration: Equatable, Sendable {
+        public var sampleRate: Int = 16_000
+        public var frameSize: Int = 160            // 10 ms @ 16 kHz
+        public var filterLengthMs: Int = 300       // echo tail the filter can model
+        public var residualEchoSuppression: Bool = true
+        public var echoSuppressDb: Int = -40       // SPEEX_PREPROCESS_SET_ECHO_SUPPRESS
+        public var echoSuppressActiveDb: Int = -15 // SPEEX_PREPROCESS_SET_ECHO_SUPPRESS_ACTIVE
+        public var noiseSuppression: Bool = false  // keep whisper's input natural
+
+        public init() {}
+
+        public init(sampleRate: Int, frameSize: Int, filterLengthMs: Int,
+                    residualEchoSuppression: Bool, echoSuppressDb: Int,
+                    echoSuppressActiveDb: Int, noiseSuppression: Bool) {
+            self.sampleRate = sampleRate
+            self.frameSize = frameSize
+            self.filterLengthMs = filterLengthMs
+            self.residualEchoSuppression = residualEchoSuppression
+            self.echoSuppressDb = echoSuppressDb
+            self.echoSuppressActiveDb = echoSuppressActiveDb
+            self.noiseSuppression = noiseSuppression
+        }
+    }
+
+    public let configuration: Configuration
+    public let frameSize: Int
+
+    /// With residual echo suppression on, the preprocessor's overlap-add adds
+    /// exactly one frame of latency; otherwise zero. See ``EchoCancellerBackend/latencySamples``.
+    public let latencySamples: Int
+
+    /// Echo-filter length actually used: `filterLengthMs` rounded up to whole frames.
+    public let filterLengthSamples: Int
+
+    // Far frames below this mean square (about -60 dBFS RMS) do not count as
+    // "far-end active" for the delay estimate.
+    private static let farActiveMeanSquare: Float = 1e-6
+    // ~2 s of far-active audio before the delay estimate is offered.
+    private static let minActiveFramesForDelay = 200
+
+    private let echoState: OpaquePointer
+    private var preprocessState: OpaquePointer?
+    private let nearBuffer: UnsafeMutablePointer<Int16>
+    private let farBuffer: UnsafeMutablePointer<Int16>
+    private let outBuffer: UnsafeMutablePointer<Int16>
+    private let impulseResponse: UnsafeMutablePointer<Int32>
+    private var farActiveFrames = 0
+
+    /// Returns nil when the configuration is unusable or Speex cannot allocate.
+    ///
+    /// Besides sane ranges the frame size must factor into primes <= 17: Speex's
+    /// kiss FFT calls exit(1) ("max radix supported is 17") for anything else,
+    /// which would take the whole app down instead of failing this initialiser.
+    public init?(configuration: Configuration = .init()) {
+        guard (4_000...192_000).contains(configuration.sampleRate),
+              (32...4_096).contains(configuration.frameSize),
+              SpeexEchoCanceller.hasSupportedFFTLength(configuration.frameSize),
+              (1...2_000).contains(configuration.filterLengthMs)
+        else { return nil }
+
+        let frameSize = configuration.frameSize
+        let wantedSamples = (configuration.filterLengthMs * configuration.sampleRate + 999) / 1000
+        let blocks = max(1, (wantedSamples + frameSize - 1) / frameSize)
+        let filterLength = blocks * frameSize
+
+        guard let echo = speex_echo_state_init(Int32(frameSize), Int32(filterLength)) else {
+            return nil
+        }
+        var rate = Int32(configuration.sampleRate)
+        _ = speex_echo_ctl(echo, SPEEX_ECHO_SET_SAMPLING_RATE, &rate)
+
+        var preprocess: OpaquePointer?
+        if configuration.residualEchoSuppression {
+            preprocess = SpeexEchoCanceller.makePreprocessor(
+                configuration: configuration, echo: echo)
+            if preprocess == nil {
+                speex_echo_state_destroy(echo)
+                return nil
+            }
+        }
+
+        let nearBuffer = UnsafeMutablePointer<Int16>.allocate(capacity: frameSize)
+        nearBuffer.initialize(repeating: 0, count: frameSize)
+        let farBuffer = UnsafeMutablePointer<Int16>.allocate(capacity: frameSize)
+        farBuffer.initialize(repeating: 0, count: frameSize)
+        let outBuffer = UnsafeMutablePointer<Int16>.allocate(capacity: frameSize)
+        outBuffer.initialize(repeating: 0, count: frameSize)
+        let impulseResponse = UnsafeMutablePointer<Int32>.allocate(capacity: filterLength)
+        impulseResponse.initialize(repeating: 0, count: filterLength)
+
+        self.configuration = configuration
+        self.frameSize = frameSize
+        self.filterLengthSamples = filterLength
+        self.latencySamples = preprocess == nil ? 0 : frameSize
+        self.echoState = echo
+        self.preprocessState = preprocess
+        self.nearBuffer = nearBuffer
+        self.farBuffer = farBuffer
+        self.outBuffer = outBuffer
+        self.impulseResponse = impulseResponse
+    }
+
+    deinit {
+        // The preprocessor holds a pointer to the echo state: destroy it first.
+        if let preprocessState {
+            speex_preprocess_state_destroy(preprocessState)
+        }
+        speex_echo_state_destroy(echoState)
+        nearBuffer.deallocate()
+        farBuffer.deallocate()
+        outBuffer.deallocate()
+        impulseResponse.deallocate()
+    }
+
+    // MARK: - EchoCancellerBackend
+
+    public func process(near: UnsafePointer<Float>, far: UnsafePointer<Float>,
+                        out: UnsafeMutablePointer<Float>) {
+        var farEnergy: Float = 0
+        for i in 0..<frameSize {
+            nearBuffer[i] = SpeexEchoCanceller.int16(from: near[i])
+            let f = far[i]
+            farBuffer[i] = SpeexEchoCanceller.int16(from: f)
+            farEnergy += f * f
+        }
+        if farEnergy > SpeexEchoCanceller.farActiveMeanSquare * Float(frameSize) {
+            farActiveFrames += 1
+        }
+
+        speex_echo_cancellation(echoState, nearBuffer, farBuffer, outBuffer)
+        if let preprocessState {
+            // In place; residual echo is estimated from the echo state set up in makePreprocessor.
+            _ = speex_preprocess_run(preprocessState, outBuffer)
+        }
+
+        for i in 0..<frameSize {
+            out[i] = Float(outBuffer[i]) / 32768
+        }
+    }
+
+    public func reset() {
+        speex_echo_state_reset(echoState)
+        farActiveFrames = 0
+        // The preprocessor has no reset call: recreate it so its noise and
+        // residual-echo history starts clean as well.
+        if let old = preprocessState {
+            speex_preprocess_state_destroy(old)
+            preprocessState = SpeexEchoCanceller.makePreprocessor(
+                configuration: configuration, echo: echoState)
+        }
+        nearBuffer.update(repeating: 0, count: frameSize)
+        farBuffer.update(repeating: 0, count: frameSize)
+        outBuffer.update(repeating: 0, count: frameSize)
+    }
+
+    public func estimatedEchoDelayMs() -> Double? {
+        guard farActiveFrames >= SpeexEchoCanceller.minActiveFramesForDelay else { return nil }
+        var size: Int32 = 0
+        _ = speex_echo_ctl(echoState, SPEEX_ECHO_GET_IMPULSE_RESPONSE_SIZE, &size)
+        let taps = Int(size)
+        guard taps > 0, taps <= filterLengthSamples else { return nil }
+        _ = speex_echo_ctl(echoState, SPEEX_ECHO_GET_IMPULSE_RESPONSE, impulseResponse)
+
+        var bestIndex = 0
+        var bestMagnitude: UInt64 = 0
+        for i in 0..<taps {
+            let magnitude = Int64(impulseResponse[i]).magnitude
+            if magnitude > bestMagnitude {
+                bestMagnitude = magnitude
+                bestIndex = i
+            }
+        }
+        guard bestMagnitude > 0 else { return nil }
+        return 1000 * Double(bestIndex) / Double(configuration.sampleRate)
+    }
+
+    // MARK: - Helpers
+
+    /// True when `n` has no prime factor above 17 (the largest radix kiss FFT supports).
+    static func hasSupportedFFTLength(_ n: Int) -> Bool {
+        var remaining = n
+        for prime in [2, 3, 5, 7, 11, 13, 17] {
+            while remaining % prime == 0 {
+                remaining /= prime
+            }
+        }
+        return remaining == 1
+    }
+
+    /// Float [-1, 1] -> Int16, scaled by 32767, rounded and clamped.
+    @inline(__always)
+    private static func int16(from x: Float) -> Int16 {
+        if x.isNaN { return 0 }
+        let v = x * 32767
+        if v >= 32767 { return 32767 }
+        if v <= -32768 { return -32768 }
+        return Int16(v.rounded())
+    }
+
+    private static func makePreprocessor(configuration c: Configuration,
+                                         echo: OpaquePointer) -> OpaquePointer? {
+        guard let state = speex_preprocess_state_init(Int32(c.frameSize), Int32(c.sampleRate)) else {
+            return nil
+        }
+        // The residual-echo estimate is taken from the echo canceller's state.
+        _ = speex_preprocess_ctl(state, SPEEX_PREPROCESS_SET_ECHO_STATE, UnsafeMutableRawPointer(echo))
+        setControl(state, SPEEX_PREPROCESS_SET_ECHO_SUPPRESS, Int32(c.echoSuppressDb))
+        setControl(state, SPEEX_PREPROCESS_SET_ECHO_SUPPRESS_ACTIVE, Int32(c.echoSuppressActiveDb))
+        // Speex applies its residual-echo gain only while the denoiser runs
+        // (preprocess.c overwrites the gain with 1 when SET_DENOISE is 0), so
+        // the denoiser stays on. With noiseSuppression == false its noise floor
+        // is 0 dB, i.e. it does not attenuate noise, only residual echo.
+        setControl(state, SPEEX_PREPROCESS_SET_DENOISE, 1)
+        setControl(state, SPEEX_PREPROCESS_SET_NOISE_SUPPRESS, c.noiseSuppression ? -15 : 0)
+        setControl(state, SPEEX_PREPROCESS_SET_AGC, 0)
+        setControl(state, SPEEX_PREPROCESS_SET_VAD, 0)
+        setControl(state, SPEEX_PREPROCESS_SET_DEREVERB, 0)
+        return state
+    }
+
+    private static func setControl(_ state: OpaquePointer, _ request: Int32, _ value: Int32) {
+        var v = value
+        _ = speex_preprocess_ctl(state, request, &v)
+    }
+}
